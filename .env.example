# Set these in Railway's erpc service Variables; never commit real secrets.
PORT=4000
ERPC_AUTH_SECRET=replace-with-a-long-random-secret
# One Alchemy API key covers every Alchemy-supported chain in erpc.yaml.
ALCHEMY_API_KEY=
# Railway: reference the private Redis service variable. Local: redis://localhost:6379
REDIS_URL=
# Example for a 512 MiB service; adjust to roughly 90% of your memory limit.
GOMEMLIMIT=460MiB
